DATABASE_URL=postgres://registry:registry@localhost:5432/tool_registry
PORT=3000
HOST=0.0.0.0
REGISTRY_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# 32-byte key encoded as 64 hex characters; used to encrypt stored credentials.
ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional comma-separated hostnames allowed for outbound HTTP tool execution.
OUTBOUND_HOST_ALLOWLIST=
# STDIO MCP runs only in a no-network, read-only Docker container with no host mounts.
MCP_STDIO_ENABLED=false
MCP_STDIO_DOCKER_BIN=docker
MCP_STDIO_IMAGE_ALLOWLIST=
MCP_SYNC_INTERVAL_MS=300000
